+
+def verified_extract(asset, archive_path, target):
+    digest = hashlib.sha256(archive_path.read_bytes()).hexdigest()
+    if asset.get('digest') != 'sha256:'+digest:
+        archive_path.unlink()
+        raise RuntimeError('Official release checksum mismatch: '+asset['name'])
+    with zipfile.ZipFile(archive_path) as archive:
+        for info in archive.infolist():
+            if not (target/info.filename).resolve().is_relative_to(target.resolve()):
+                raise RuntimeError('Unsafe archive path.')
+        archive.extractall(target)
+
+
+def install_cuda(release):
+    target = ROOT/'.native/llama-cuda'
+    target.mkdir(parents=True, exist_ok=True)
+    assets = [next(item for item in release['assets'] if item['name'] == name) for name in CUDA_ASSETS]
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        list(pool.map(lambda a: fetch(a['browser_download_url'], target/a['name']), assets))
+    for asset in assets:
