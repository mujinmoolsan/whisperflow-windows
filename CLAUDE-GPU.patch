+def fetch(url, path):
+    if path.is_file():
+        return
+    temporary = path.with_suffix(path.suffix+'.partial')
+    with urllib.request.urlopen(url, timeout=120) as response, temporary.open('wb') as file:
+        while data := response.read(1024*1024):
