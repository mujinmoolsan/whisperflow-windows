+"""Prepare a PRIVATE reference clip. Never adds recordings to Git."""
+import argparse
+from pathlib import Path
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('source', type=Path)
+    parser.add_argument('--character', choices=['jarvis', 'deckard'], required=True)
+    parser.add_argument('--start', type=float, default=0)
+    parser.add_argument('--duration', type=float, default=12)
+    args = parser.parse_args()
+    if not args.source.is_file() or args.start < 0 or not 3 <= args.duration <= 30:
+        parser.error('Choose an existing audio file and a 3–30 second speech excerpt.')
+    import imageio_ffmpeg
+    root = Path(__file__).resolve().parent
