+def persona_reply(character,text):
+    if character=='deckard' and not text.startswith('친구야'):
+        return '친구야, '+text.replace('해 주세요','해 줘').replace('확인해 주십시오','확인해 줘')
+    return text
+
+
+def spoken_text(text):
+    return re.sub(r'[`*#]','',text).strip()
+
+
+def _flat(text):
+    return re.sub(r'\s+',' ',text).strip()
+
+
+class DraftSpeech:
+    """Speak finished sentences of a streaming reply before the final result.
+
+    Only sentences followed by more text are treated as stable. If the draft
+    rewrites an already-spoken sentence or grows past SPOKEN_LIMIT, nothing
+    more is added; the final result then only appends text that continues
+    exactly what was already spoken.
+    """
+    def __init__(self,character):
+        self.character=character
+        self.parts=[]
+        self.finished=False
+        self.frozen=False
+        self.changed=asyncio.Event()
+        self.task=None
+
+    def stable_segments(self,draft):
+        text=spoken_text(persona_reply(self.character,draft))
+        pieces=re.split(r'(?<=[.!?。！？])\s+|\n+',text)
+        return [part for piece in pieces[:-1] for part in segments(piece)]
+
+    def feed(self,draft):
+        if self.finished or self.frozen:
+            return False
+        stable=self.stable_segments(draft)
+        if stable[:len(self.parts)]!=self.parts:
+            self.frozen=True
+            return False
+        added=False
+        for part in stable[len(self.parts):]:
+            if len(_flat(' '.join(self.parts+[part])))>SPOKEN_LIMIT:
+                self.frozen=True
+                break
+            self.parts.append(part)
+            added=True
+        if added:
+            self.changed.set()
+        return added
+
+    def finish(self,final_spoken=None):
+        if self.finished:
+            return
+        if final_spoken is not None and not self.frozen:
+            said,final=_flat(' '.join(self.parts)),_flat(final_spoken)
+            if final.startswith(said):
+                self.parts.extend(segments(final[len(said):].strip()))
+        self.finished=True
+        self.changed.set()
 
 
